rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------
    // 1. Funções utilitárias
    // ---------------------------------------------
    
    // Autenticação obrigatória
    function signedIn() {
      return request.auth != null;
    }

    // Confere se o usuário logado é o dono do documento
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Sistema de administradores
    function isAdmin() {
      // Admins são definidos diretamente no auth token.
      // Ex: no backend: auth.setCustomUserClaims(uid, { admin: true })
      return signedIn() && request.auth.token.admin == true;
    }

    // Verifica se "name" existe e é string
    function validCompanyCreate() {
      return request.resource.data.keys().hasOnly(["name"]) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() > 0;
    }

    // Para updates -> só "name" pode ser alterado (se quiser limitar)
    function validCompanyUpdate() {
      return request.resource.data.keys().hasOnly(["name"]) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() > 0;
    }

    // Para scopedData:
    // Qualquer tipo é aceito, desde que exista o campo "value"
    function validScopedData() {
      return request.resource.data.keys().hasOnly(["value"]);
    }

    // ---------------------------------------------
    // 2. Regras principais
    // ---------------------------------------------
    match /users/{userId} {
      // Protege o nó raiz de users (não deve ser acessado diretamente)
      allow read, write: if false;

      // ---------------------------------------------
      // 3. Coleção companies
      // ---------------------------------------------
      match /companies/{companyId} {

        // Criar empresa
        allow create: if isOwner(userId) && validCompanyCreate();
        
        // Ler empresa
        allow get, list: if isOwner(userId) || isAdmin();

        // Atualizar empresa
        allow update: if
          (
            isOwner(userId) &&
            validCompanyUpdate()     // Permite somente alterar "name"
          )
          ||
          isAdmin();                 // Admin pode editar qualquer campo

        // Deletar empresa
        allow delete: if
          isAdmin()                 // Somente admin pode deletar
          ||
          (isOwner(userId) && false); // Proprietário NÃO pode deletar (bloqueado)

        // ---------------------------------------------
        // 4. Subcoleção scopedData
        // ---------------------------------------------
        match /scopedData/{dataKey} {

          // Scoped data pode ser criado pelo dono ou admin
          allow create: if
            (isOwner(userId) && validScopedData())
            ||
            isAdmin();

          // Ler scoped data
          allow get, list: if isOwner(userId) || isAdmin();

          // Atualizar scoped data
          allow update: if
            (isOwner(userId) && validScopedData())
            ||
            isAdmin();

          // Deletar scoped data → somente admin
          allow delete: if isAdmin();
        }
      }
    }
  }
}
