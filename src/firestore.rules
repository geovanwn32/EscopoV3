
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserAdmin(userId) {
        // Check a 'global-users' collection to see if the user has an 'isAdmin' flag.
        return exists(/databases/$(database)/documents/global-users/$(userId)) &&
               get(/databases/$(database)/documents/global-users/$(userId)).data.isAdmin == true;
    }
    
    function isUserMaster(userId) {
        return exists(/databases/$(database)/documents/global-users/$(userId)) &&
               get(/databases/$(database)/documents/global-users/$(userId)).data.isMaster == true;
    }

    // Global collection for user profiles and roles.
    match /global-users/{userId} {
      // Admins and the user themselves can read their own profile.
      allow get: if isSignedIn() && (isUserAdmin(request.auth.uid) || request.auth.uid == userId);
      // Only admins can list all users.
      allow list: if isSignedIn() && isUserAdmin(request.auth.uid);
      
      // Users can create their own profile upon sign-up.
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Admins can update any user, users can only update their own profile.
      // A user cannot make themselves an admin or master.
      allow update: if isSignedIn() && 
                      (isUserAdmin(request.auth.uid) || request.auth.uid == userId) &&
                      (isUserAdmin(request.auth.uid) || (
                        request.resource.data.isAdmin == resource.data.isAdmin &&
                        request.resource.data.isMaster == resource.data.isMaster
                      ));
      
      // Only Master users can delete other users, but not themselves or another Master.
      allow delete: if isSignedIn() && isUserMaster(request.auth.uid) && request.auth.uid != userId && resource.data.isMaster != true;
    }
    
    // Multi-tenant data, scoped by company
    match /empresas/{empresaId}/{document=**} {
      // The user must be authenticated and must be a member of the company.
      // We check a user's allowed companies from their profile in 'global-users'.
      allow read, write: if isSignedIn() &&
                         get(/databases/$(database)/documents/global-users/$(request.auth.uid)).data.allowedCompanyIds.hasAny([empresaId]);
    }
  }
}
